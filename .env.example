DOMAIN=example.com
ACME_EMAIL=your@email.com

POSTGRES_DB=chatdb
POSTGRES_USER=chatuser
POSTGRES_PASSWORD=changeme

# Mindst 32 tilfældige tegn
JWT_SECRET=skift-mig-til-en-lang-tilfaeldig-streng

# DNSLink-domænet for din IPFS-frontend, fx https://app.example.com
# Brug * under lokal udvikling
ALLOWED_ORIGIN=https://app.example.com

# Cloudflare Turnstile — dash.cloudflare.com → Turnstile
# Lad stå tom for at springe CAPTCHA over (lokal udvikling)
TURNSTILE_SECRET=

# Resend — resend.com → API Keys
# Lad stå tom for at springe email over og auto-verificere (lokal udvikling)
RESEND_API_KEY=
RESEND_FROM=noreply@example.com

# Backendets offentlige URL — bruges i verifikationslinks i emails
BASE_URL=http://localhost:8001

# Frontendets offentlige URL — bruges som redirect efter email-verifikation
FRONTEND_URL=http://localhost:8001

# TURN-server til WebRTC NAT-traversal (kun prod — sættes af Ansible)
VPS_IP=your-vps-ip
TURN_SECRET=change-me
