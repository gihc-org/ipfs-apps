# Loft backend (chat/)

# PostgreSQL-forbindelse — kræves. Lokalt:
# DATABASE_URL=postgres://loft:changeme@localhost:5432/loftdb
DATABASE_URL=postgres://loft:changeme@localhost:5432/loftdb

# Brug * under lokal udvikling. I k8s er frontend og API samme origin, så
# værdien bruges kun til CORS ved lokal kørsel.
ALLOWED_ORIGIN=*

# Hvor mange timer et loft lever uden aktivitet, før det slettes (default 168)
LOFT_TTL_HOURS=168
